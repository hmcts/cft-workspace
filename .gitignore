# cft-workspace gitignore
#
# This repo tracks scaffolding only. Cloned-in HMCTS repos (under apps/<area>/<repo>,
# libs/<repo>, platops/<repo>) are external — workspace.yaml lists them; bootstrap
# clones them. Per-engineer scratch files inside area dirs (DB dumps, TODO notes,
# scratch SQL) are also not tracked.

# 1) External clones
/apps/*/*/
/libs/*/
/platops/*/

# 2) Everything inside an area dir (apps/<area>/*) is ignored unless re-included.
/apps/*/*
!/apps/*/CLAUDE.md
!/apps/*/README.md
!/apps/*/.gitkeep
!/apps/*/docs/
# The team's Claude Code plugin — workspace-repo scaffolding like docs/, not
# clone-local. Catalogued in .claude-plugin/marketplace.json.
!/apps/*/.claude/

# 3) libs/ and platops/ contain only repo clones; allow only .gitkeep at the top.
/libs/*
/platops/*
!/libs/.gitkeep
!/platops/.gitkeep

# 4) Workspace-installed tools
/.bin/

# 5) Local Claude state (workspace publishes settings.json, not local overrides)
/.claude/scheduled_tasks.lock
/.claude/settings.local.json
/.claude/*.env
/.claude/knowledge-sweep/

# 6) docs-generate pipeline working state (per-product .work/ caches: research notes,
#    Confluence dumps, manifest). Regenerable from page frontmatter; not committed.
/apps/*/docs/.work/

# 7) IDE / OS noise
.DS_Store
.idea/
*.iml
*.swp
*~

# 7) Secrets — belt-and-braces (no secret should ever live in a .env file in this repo)
.env
.env.local
*.pem
*.p12

# 8) Local MD files

*.local.md

# Per-engineer working files that belong to a clone but must live on the host. The clones are on Docker
# named volumes, so anything untracked inside one is lost to `docker volume prune` — these are kept here,
# on the bind-mounted workspace repo, and symlinked back into each clone by scripts/link-local-notes.
# Ignored rather than tracked because they are personal: `rules-of-engagement.md` is per-engineer
# instruction (one per clone, differing by START_TOKEN) and the `steve*` files are scratch notes.
/local-notes/

# 9) The deed-poll programme's clones
#
# Four independently-cloned repos, ignored for the same reason apps/, libs/ and platops/ are: their
# contents belong in their own VCS history, never this one.

deed-poll-admin

deed-poll-web

deed-poll-api

deed-poll-infra

.devcontainer/claudeinit.sh

# Redundant since #14 put ralphex in the image, but kept ignored rather than unignored: the directory is
# still on disk and is still what /usr/local/bin/ralphex resolves to in an already-running container.
# Delete the directory, and this line, after the next devcontainer rebuild.
.devcontainer/local-bin/

