#!/usr/bin/env bash
# Detect doc drift across the workspace, in three modes:
#
#   port       — compare docs/ (ported from platops/hmcts.github.io) against
#                upstream via docs/.port-manifest.yaml. Existing behaviour.
#   source     — compare Diátaxis pages' `sources:` frontmatter against the
#                current SHA of each cited source file in its cloned repo.
#   confluence — list pages with `confluence:` frontmatter so the /docs-drift
#                skill can call the Atlassian MCP per page. (This script can't
#                make MCP calls itself.)
#   auto       — run port + source, then list confluence-eligible pages. Default.
#
# Usage:
#   scripts/doc-drift                                # all modes (auto)
#   scripts/doc-drift --mode=port [--pull]           # port-manifest only
#   scripts/doc-drift --mode=source                  # source-citation only
#   scripts/doc-drift --mode=confluence              # list confluence pages
#   scripts/doc-drift --product=<slug>               # restrict to one product
#                                                    # (workspace = root docs/)
#   scripts/doc-drift --record [--product=<slug>]    # WRITES: pin each page's
#                                                    # sources_sha: to the SHAs
#                                                    # observed now. Implies
#                                                    # --mode=source. Run only
#                                                    # after verifying the pages
#                                                    # are accurate — it asserts
#                                                    # "correct as of now".
#
# Citation grammar for a `sources:` entry:
#
#   <repo-slug>[@<branch>]:<path>[@<sha>]
#
# `@<branch>` pins to a branch (for files only on an unmerged branch); a trailing
# `@<sha>` pins the expected commit inline instead of via `sources_sha:`.
# Unpinned citations resolve against the repo's default branch, not the working
# tree, so a clone parked on a feature branch doesn't produce false "broken".
#
# Exit non-zero if any actionable drift was found (port or source modes).

source "$(dirname "$0")/lib/_common.sh"

require_yq
cd "$WORKSPACE_ROOT"

MODE=auto
PRODUCT=
DO_PULL=0
DO_RECORD=0

for arg in "$@"; do
    case "$arg" in
        --mode=*)     MODE="${arg#*=}"   ;;
        --product=*)  PRODUCT="${arg#*=}" ;;
        --pull)       DO_PULL=1           ;;
        --record)     DO_RECORD=1; MODE=source ;;
        -h|--help)
            sed -n '2,/^$/p' "$0" | sed 's/^# *//'
            exit 0
            ;;
        *)
            die "unknown arg: $arg"
            ;;
    esac
done

case "$MODE" in
    port|source|confluence|auto) ;;
    *) die "unknown --mode: $MODE (expected port, source, confluence, or auto)" ;;
esac

# ─── per-page path discovery ────────────────────────────────────────────────
# Return Diátaxis pages under the in-scope tree(s) on stdout, one path per line.
discover_pages() {
    local roots=()
    if [[ -z "$PRODUCT" ]]; then
        roots=(docs apps/*/docs)
    elif [[ "$PRODUCT" == "workspace" ]]; then
        roots=(docs)
    else
        roots=("apps/$PRODUCT/docs")
    fi
    for root in "${roots[@]}"; do
        [[ -d "$root" ]] || continue
        # Per-level find: a single brace-expanded find aborts on the first
        # missing level, silently dropping every later root under `set -e`.
        for level in tutorials how-to reference explanation; do
            [[ -d "$root/$level" ]] || continue
            find "$root/$level" -type f -name '*.md' ! -name 'README.md' \
                ! -path '*/.work/*'
        done
    done
}

# Extract YAML frontmatter (the block between the first two `---` lines).
extract_frontmatter() {
    awk '/^---[[:space:]]*$/{c++; if(c==2)exit; if(c>0)next} c==1{print}' "$1"
}

# Parse a source citation into its parts. Grammar:
#
#   <slug>[@<ref>]:<path>[@<sha>]
#
# `@<ref>` pins the citation to a branch (for files that live only on an
# unmerged branch); a trailing `@<sha>` pins the expected commit inline instead
# of via the page's `sources_sha:` map. A bare path with no slug is the legacy
# workspace-relative form used by some early CCD pages.
#
# Sets CIT_SLUG, CIT_REF, CIT_PATH, CIT_PIN — empty when the part is absent.
parse_citation() {
    local entry="$1"
    CIT_SLUG=; CIT_REF=; CIT_PATH=; CIT_PIN=

    if [[ "$entry" != *:* ]]; then
        CIT_PATH="$entry"
    else
        CIT_SLUG="${entry%%:*}"
        CIT_PATH="${entry#*:}"
        if [[ "$CIT_SLUG" == *@* ]]; then
            CIT_REF="${CIT_SLUG#*@}"
            CIT_SLUG="${CIT_SLUG%%@*}"
        fi
    fi

    # A trailing @<hex> is a pinned SHA, not part of the filename.
    if [[ "$CIT_PATH" =~ ^(.+)@([0-9a-f]{7,40})$ ]]; then
        CIT_PATH="${BASH_REMATCH[1]}"
        CIT_PIN="${BASH_REMATCH[2]}"
    fi
}

# Echo the workspace-relative repo root for a citation slug; non-zero if unknown.
resolve_repo_root() {
    local slug="$1"
    [[ -n "$slug" ]] || return 1

    # Slug is itself a workspace-relative directory (e.g. `platops/cnp-flux-config`).
    if [[ -d "$slug" ]]; then printf '%s' "$slug"; return 0; fi

    # Slug is a repo basename — find under apps/, libs/, platops/.
    local found
    found=$(find apps libs platops -mindepth 1 -maxdepth 3 -type d -name "$slug" 2>/dev/null | head -1)
    [[ -n "$found" ]] && { printf '%s' "$found"; return 0; }
    return 1
}

# Echo a repo's default branch (origin/HEAD, falling back to origin/master|main).
default_ref_for() {
    local repo_root="$1" head
    head=$(git -C "$repo_root" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)
    if [[ -n "$head" ]]; then printf '%s' "$head"; return 0; fi
    local ref
    for ref in origin/master origin/main; do
        git -C "$repo_root" rev-parse --verify --quiet "$ref" >/dev/null && { printf '%s' "$ref"; return 0; }
    done
    return 1
}

# Echo the current SHA of the parsed citation's file. Non-zero when the file (or
# the blob on the pinned ref) doesn't exist, which the caller reports as broken.
#
# Unpinned citations resolve against the repo's DEFAULT branch, not the working
# tree: clones are routinely parked on unrelated feature branches, and a
# checked-out branch predating the cited file would otherwise report it broken.
#
# That resolution is exclusive — there is deliberately no HEAD fallback. A path
# absent from the default branch is broken even when the local checkout still
# carries it: the alternative reports a SHA reachable only in this working copy,
# which reads as "fresh" here and breaks for everyone else, and which `--record`
# would then pin into the page's sources_sha:. Cite `<slug>@<branch>:<path>` for
# a file that genuinely lives only on an unmerged branch.
citation_current_sha() {
    local repo_root="$1"
    local -a refs=()

    if [[ -n "$CIT_REF" ]]; then
        refs=("origin/$CIT_REF" "$CIT_REF")
    else
        local def
        def=$(default_ref_for "$repo_root" || true)
        if [[ -n "$def" ]]; then
            refs=("$def")
        else
            # Neither origin/HEAD nor origin/master|main resolves — a clone with
            # no remote at all. The checked-out branch is the only ref there is,
            # so use it rather than calling every citation in the repo broken.
            refs=(HEAD)
        fi
    fi

    local ref
    for ref in "${refs[@]}"; do
        # `rev-parse --verify`, not `cat-file -e`: both answer "does this path
        # exist on this ref", but cat-file needs the BLOB, which a blobless
        # clone (--filter=blob:none, as scripts/ci-clone-cited makes) doesn't
        # have — it would either trigger a per-file lazy fetch or, offline,
        # wrongly report every citation broken. rev-parse resolves from the
        # tree alone, which blobless clones do carry in full.
        if git -C "$repo_root" rev-parse --verify --quiet "$ref:$CIT_PATH" >/dev/null 2>&1; then
            git -C "$repo_root" log -1 --format=%H "$ref" -- "$CIT_PATH" 2>/dev/null
            return 0
        fi
    done
    return 1
}

# Locate the git repo (containing .git) that owns a given file. Echoes the
# workspace-relative repo root; non-zero on failure. Used to scope `git log`.
git_repo_for() {
    local file="$1"
    local dir
    dir=$(dirname "$file")
    while [[ "$dir" != "." && "$dir" != "/" && -n "$dir" ]]; do
        if [[ -d "$dir/.git" || -f "$dir/.git" ]]; then
            printf '%s' "$dir"
            return 0
        fi
        dir=$(dirname "$dir")
    done
    return 1
}

# ─── port mode (existing logic) ─────────────────────────────────────────────
run_port_mode() {
    local manifest="$WORKSPACE_ROOT/docs/.port-manifest.yaml"
    local upstream_dir="$WORKSPACE_ROOT/platops/hmcts.github.io"

    if [[ ! -f "$manifest" || ! -d "$upstream_dir/.git" ]]; then
        warn "port mode skipped — missing manifest or upstream clone"
        return 0
    fi

    if [[ -n "$PRODUCT" && "$PRODUCT" != "workspace" ]]; then
        # port-manifest only covers root docs/; skip for other products.
        return 0
    fi

    if (( DO_PULL )); then
        local default_branch
        default_branch=$(yq -r '.upstream_branch' "$manifest")
        if ! git -C "$upstream_dir" diff --quiet || ! git -C "$upstream_dir" diff --cached --quiet; then
            die "upstream clone has uncommitted changes — refusing to pull"
        fi
        local current_branch
        current_branch=$(git -C "$upstream_dir" symbolic-ref --short HEAD 2>/dev/null || echo '')
        [[ "$current_branch" != "$default_branch" ]] && die "upstream on '$current_branch', expected '$default_branch'"
        info "fetching upstream…"
        git -C "$upstream_dir" fetch origin --quiet
        git -C "$upstream_dir" pull --ff-only --quiet origin "$default_branch"
    fi

    local upstream_head upstream_root
    upstream_head=$(git -C "$upstream_dir" rev-parse HEAD)
    upstream_root=$(yq -r '.upstream_path_root' "$manifest")

    printf '\n=== port mode (upstream HEAD: %s) ===\n\n' "$upstream_head"

    local needs=() insync=() removed=() new=()

    while IFS=$'\t' read -r target source synced_sha; do
        local src_full="$upstream_dir/$upstream_root/$source"
        if [[ ! -f "$src_full" ]]; then
            removed+=("$target ← $source")
            continue
        fi
        local commits
        commits=$(git -C "$upstream_dir" log --oneline "$synced_sha"..HEAD -- "$upstream_root/$source" 2>/dev/null || echo '')
        if [[ -z "$commits" ]]; then
            insync+=("$target")
        else
            needs+=("$target	$source	$synced_sha	$(echo "$commits" | wc -l)")
        fi
    done < <(yq -r '.entries[] | [.target, .source, .synced_sha] | @tsv' "$manifest")

    # new-upstream scan
    mapfile -t known < <(yq -r '.entries[].source' "$manifest")
    mapfile -t dropped < <(yq -r '.dropped[]' "$manifest")
    while IFS= read -r src_full; do
        local rel="${src_full#"$upstream_dir/$upstream_root/"}"
        local skip=0
        for k in "${known[@]}";   do [[ "$rel" == "$k" ]] && skip=1; done
        for g in "${dropped[@]}"; do
            if [[ "$g" == *'**' ]]; then [[ "$rel" == "${g%\*\*}"* ]] && skip=1
            else [[ "$rel" == "$g" ]] && skip=1; fi
        done
        (( skip )) || new+=("$rel")
    done < <(find "$upstream_dir/$upstream_root" -type f \( -name '*.html.md.erb' -o -name '*.md' \))

    ok "${#insync[@]} in-sync"
    if (( ${#needs[@]} )); then
        warn "${#needs[@]} needs-update:"
        for line in "${needs[@]}"; do
            IFS=$'\t' read -r target source sha n <<< "$line"
            printf '  %s (%s commits behind, synced %s)\n' "$target" "$n" "$sha"
        done
    else ok "0 needs-update"; fi
    if (( ${#removed[@]} )); then
        warn "${#removed[@]} removed-upstream:"; printf '  %s\n' "${removed[@]}"
    fi
    if (( ${#new[@]} )); then
        warn "${#new[@]} new-upstream:"; printf '  %s\n' "${new[@]}"
    fi

    PORT_DRIFT=$(( ${#needs[@]} + ${#removed[@]} + ${#new[@]} ))
}

# Rewrite a page's `sources_sha:` frontmatter block from TSV `citation<TAB>sha`
# pairs. Only the frontmatter is passed through yq; the body is copied verbatim
# so prose, code fences, and blank lines are untouched.
write_sources_sha() {
    local page="$1"; shift
    (( $# )) || return 1

    local fm_end
    fm_end=$(awk 'NR>1 && /^---[[:space:]]*$/{print NR; exit}' "$page")
    [[ -n "$fm_end" ]] || { warn "no frontmatter in $page — skipped"; return 1; }

    local tmp_fm tmp_map out
    tmp_fm=$(mktemp); tmp_map=$(mktemp); out=$(mktemp)

    sed -n "2,$((fm_end - 1))p" "$page" > "$tmp_fm"

    # Build the map as YAML rather than interpolating into a yq expression, so
    # citation strings can't be read as expression syntax.
    local pair
    for pair in "$@"; do
        printf '%s: "%s"\n' "\"${pair%%$'\t'*}\"" "${pair#*$'\t'}" >> "$tmp_map"
    done

    if ! yq -i '.sources_sha = load("'"$tmp_map"'")' "$tmp_fm" 2>/dev/null; then
        rm -f "$tmp_fm" "$tmp_map" "$out"
        warn "failed to rewrite frontmatter for $page"
        return 1
    fi

    { printf -- '---\n'; cat "$tmp_fm"; printf -- '---\n'; tail -n "+$((fm_end + 1))" "$page"; } > "$out"
    mv "$out" "$page"
    rm -f "$tmp_fm" "$tmp_map"
    return 0
}

# ─── source mode ────────────────────────────────────────────────────────────
run_source_mode() {
    printf '\n=== source mode ===\n\n'

    local fresh=() stale=() broken=() untracked=() unpinned_pages=() recorded_pages=()

    while IFS= read -r page; do
        local fm
        fm=$(extract_frontmatter "$page") || true
        local sources
        sources=$(printf '%s' "$fm" | yq -r '.sources[]?' - 2>/dev/null || true)
        if [[ -z "$sources" ]]; then
            untracked+=("$page")
            continue
        fi

        local sha_map
        sha_map=$(printf '%s' "$fm" | yq -o=json '.sources_sha // {}' - 2>/dev/null || echo '{}')

        local stale_sources=() broken_sources=() record_pairs=() unpinned=0 total=0
        while IFS= read -r src; do
            [[ -z "$src" ]] && continue
            total=$(( total + 1 ))
            parse_citation "$src"

            local repo_root
            if [[ -n "$CIT_SLUG" ]]; then
                repo_root=$(resolve_repo_root "$CIT_SLUG" || true)
            else
                # Legacy bare-path form: locate the owning repo, if any.
                repo_root=$(git_repo_for "$CIT_PATH" || true)
                if [[ -z "$repo_root" ]]; then
                    # Workspace-tracked file (e.g. docs/reference/taxonomy.md) — exists
                    # but isn't SHA-trackable through this mechanism.
                    [[ -f "$CIT_PATH" ]] || broken_sources+=("$src")
                    continue
                fi
                CIT_PATH="${CIT_PATH#"$repo_root/"}"
            fi
            if [[ -z "$repo_root" ]]; then
                broken_sources+=("$src (repo not cloned)")
                continue
            fi

            local current_sha
            current_sha=$(citation_current_sha "$repo_root" || true)
            if [[ -z "$current_sha" ]]; then
                broken_sources+=("$src")
                continue
            fi

            # An inline @<sha> pin wins over the page-level sources_sha: map.
            local recorded_sha="$CIT_PIN"
            if [[ -z "$recorded_sha" ]]; then
                recorded_sha=$(printf '%s' "$sha_map" | yq -r ".\"$src\" // \"\"" - 2>/dev/null || echo '')
            fi

            if (( DO_RECORD )); then
                # Record the observed SHA regardless of what was pinned before —
                # `--record` means "the page is correct as of now".
                record_pairs+=("$src	$current_sha")
            elif [[ -z "$recorded_sha" ]]; then
                unpinned=$(( unpinned + 1 ))
            elif [[ "$current_sha" != "$recorded_sha"* ]]; then
                stale_sources+=("$src ($recorded_sha → ${current_sha:0:12})")
            fi
        done <<< "$sources"

        if (( DO_RECORD )); then
            if (( ${#broken_sources[@]} )); then
                broken+=("$page: ${broken_sources[*]}")
            elif write_sources_sha "$page" "${record_pairs[@]}"; then
                recorded_pages+=("$page (${#record_pairs[@]} SHAs)")
            fi
            continue
        fi

        if (( ${#broken_sources[@]} )); then
            broken+=("$page: ${broken_sources[*]}")
        elif (( ${#stale_sources[@]} )); then
            stale+=("$page: ${#stale_sources[@]} of $total sources changed — ${stale_sources[*]}")
        elif (( unpinned == total )); then
            unpinned_pages+=("$page ($total sources, no recorded SHAs)")
        else
            fresh+=("$page")
        fi
    done < <(discover_pages)

    if (( DO_RECORD )); then
        ok "${#recorded_pages[@]} pages pinned"
        if (( ${#broken[@]} )); then
            warn "${#broken[@]} skipped (unresolvable citations — fix these by hand):"
            printf '  %s\n' "${broken[@]}"
        fi
        SOURCE_DRIFT=${#broken[@]}
        return 0
    fi

    ok "${#fresh[@]} fresh"
    if (( ${#stale[@]} )); then warn "${#stale[@]} stale:"; printf '  %s\n' "${stale[@]}"; else ok "0 stale"; fi
    if (( ${#broken[@]} )); then warn "${#broken[@]} broken:"; printf '  %s\n' "${broken[@]}"; fi
    if (( ${#unpinned_pages[@]} )); then
        warn "${#unpinned_pages[@]} unpinned (cited sources but no SHAs recorded — staleness undetectable):"
        printf '  %s\n' "${unpinned_pages[@]}"
    fi
    if (( ${#untracked[@]} )); then info "${#untracked[@]} untracked (no sources: frontmatter)"; fi

    SOURCE_DRIFT=$(( ${#stale[@]} + ${#broken[@]} ))
}

# ─── confluence mode (script lists candidates; skill calls MCP) ─────────────
run_confluence_mode() {
    printf '\n=== confluence mode ===\n\n'
    info "pages with confluence: frontmatter (the /docs-drift skill checks each via MCP):"

    local count=0
    while IFS= read -r page; do
        local fm
        fm=$(extract_frontmatter "$page")
        local has
        has=$(printf '%s' "$fm" | yq -r '.confluence // [] | length' - 2>/dev/null)
        if [[ "$has" != "0" && -n "$has" && "$has" != "null" ]]; then
            local checked_at
            checked_at=$(printf '%s' "$fm" | yq -r '.confluence_checked_at // ""' - 2>/dev/null)
            printf '  %s (confluence_checked_at=%s)\n' "$page" "${checked_at:-never}"
            count=$((count+1))
        fi
    done < <(discover_pages)

    ok "$count pages have confluence frontmatter"
}

# ─── dispatch ───────────────────────────────────────────────────────────────
PORT_DRIFT=0
SOURCE_DRIFT=0

case "$MODE" in
    port)       run_port_mode ;;
    source)     run_source_mode ;;
    confluence) run_confluence_mode ;;
    auto)       run_port_mode; run_source_mode; run_confluence_mode ;;
esac

# Exit non-zero if there's actionable drift to act on.
if (( PORT_DRIFT + SOURCE_DRIFT )); then
    exit 1
fi
