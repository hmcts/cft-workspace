#!/usr/bin/env bash
# Ripgrep wrapper that searches across all cloned repos with sensible CFT excludes.
# Anything you'd pass to rg works — just `scripts/grep "Notice of Change"` etc.
#
# Arguments after the pattern that name an existing path and contain a `/` (or
# are `.` or `..`) replace the default roots (apps libs platops), so
# `scripts/grep -l foo docs/ apps/*/docs/` searches only the doc trees. Paths
# resolve against your current directory first, then the workspace root.
# Output paths are relative to the workspace root.

source "$(dirname "$0")/lib/_common.sh"

command -v rg >/dev/null || die "ripgrep (rg) not installed"
shopt -s extglob

caller_pwd=$PWD
cd "$WORKSPACE_ROOT"

# Absolute path of $1, trying the caller's directory then the workspace root.
resolve() {
    local base candidate
    for base in "$caller_pwd" "$WORKSPACE_ROOT"; do
        if [[ $1 == /* ]]; then candidate=$1; else candidate=$base/$1; fi
        if [[ -d $candidate ]]; then
            (cd "$candidate" && pwd)
            return 0
        elif [[ -e $candidate ]]; then
            printf '%s/%s\n' "$(cd "$(dirname "$candidate")" && pwd)" "$(basename "$candidate")"
            return 0
        fi
        [[ $1 == /* ]] && break
    done
    return 1
}

# Only arguments that look like paths are taken out, so rg's own option parsing
# is never second-guessed. The first non-option argument is the pattern unless
# the pattern comes from -e / -f, or --files means there is none.
pattern_pending=1
for arg in "$@"; do
    case "$arg" in
        -e|-e?*|--regexp|--regexp=*|-f|-f?*|--file|--file=*|--files) pattern_pending=0 ;;
    esac
done
rg_args=()
paths=()
after_dashdash=0
prev=
for arg in "$@"; do
    if (( ! after_dashdash )) && [[ $arg == -* ]]; then
        [[ $arg == -- ]] && after_dashdash=1
        rg_args+=("$arg")
    elif (( pattern_pending )); then
        pattern_pending=0
        rg_args+=("$arg")
    elif [[ $prev == @(-f|--file|--ignore-file|--pre) ]] || [[ $arg != */* && $arg != . && $arg != .. ]]; then
        rg_args+=("$arg")
    elif abs=$(resolve "$arg"); then
        paths+=("$abs")
    elif [[ $arg == @(apps|libs|platops|docs|.|..)/* && $arg != *[*?[{]* ]]; then
        die "scripts/grep: no such path: $arg"
    else
        rg_args+=("$arg")
    fi
    prev=$arg
done
(( ${#paths[@]} )) || paths=("$WORKSPACE_ROOT/apps" "$WORKSPACE_ROOT/libs" "$WORKSPACE_ROOT/platops")

clones=()
for git_dir in apps/*/*/.git libs/*/.git platops/*/.git; do
    [[ -e $git_dir ]] && clones+=("${git_dir%/.git}")
done

# rg applies the workspace .gitignore, which ignores every clone, unreliably: a
# root such as apps/<product>/ searches none of its clones, while apps/ searches
# them all. So a root outside any clone is searched as the workspace files git
# does not ignore under it plus each clone under it as a root of its own. That
# keeps gitignored workspace files (credentials, *.local.md) hidden, and parent
# ignores stay on so each clone's gitignored output stays hidden too.
roots=()
for abs in "${paths[@]}"; do
    if [[ $abs == "$WORKSPACE_ROOT" ]]; then
        rel=.
    elif [[ $abs == "$WORKSPACE_ROOT"/* ]]; then
        rel=${abs#"$WORKSPACE_ROOT"/}
    else
        roots+=("$abs")
        continue
    fi
    for clone in ${clones[@]+"${clones[@]}"}; do
        if [[ $rel == "$clone" || $rel == "$clone"/* ]]; then
            roots+=("$rel")
            continue 2
        fi
    done
    while IFS= read -r -d '' file; do
        [[ -e $file ]] && roots+=("$file")
    done < <(git ls-files -z --cached --others --exclude-standard -- "$rel")
    for clone in ${clones[@]+"${clones[@]}"}; do
        [[ $rel == . || $clone == "$rel"/* ]] && roots+=("$clone")
    done
done
(( ${#roots[@]} )) || die "scripts/grep: nothing to search under ${paths[*]}"

# Overlapping paths yield the same root twice. Dedupe once at the end: a
# per-add scan is quadratic, around 300 ms for the ~500 unscoped roots, and
# declare -A needs bash 4, which stock macOS lacks.
unique=()
while IFS= read -r root; do
    unique+=("$root")
done < <(printf '%s\n' "${roots[@]}" | awk '!seen[$0]++')
roots=("${unique[@]}")

exec rg \
    --hidden \
    --glob '!**/.git' \
    --glob '!**/.claude/worktrees' \
    --glob '!**/docs/.work' \
    --glob '!**/node_modules' \
    --glob '!**/build' \
    --glob '!**/.gradle' \
    --glob '!**/target' \
    --glob '!**/dist' \
    --glob '!**/coverage' \
    --glob '!**/.terraform' \
    --glob '!**/*.lock' \
    --glob '!**/yarn.lock' \
    --glob '!**/package-lock.json' \
    --glob '!**/gradle/wrapper/gradle-wrapper.jar' \
    ${rg_args[@]+"${rg_args[@]}"} \
    "${roots[@]}"
