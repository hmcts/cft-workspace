#!/usr/bin/env bash
# Review recent Claude Code conversations for durable CFT knowledge and propose
# documentation updates.
#
# Hooked to SessionStart, not SessionEnd: SessionEnd only fires on orderly exits,
# so a closed IDE or stopped devcontainer would lose the trigger. Transcripts are
# appended live, so a per-session byte offset is enough to sweep late without
# missing anything.
#
# Usage:
#   scripts/knowledge-sweep                # sweep now, honouring the interval
#   scripts/knowledge-sweep --background   # detach and return immediately (hook)
#   scripts/knowledge-sweep --force        # ignore the interval
#   scripts/knowledge-sweep --status       # what's pending, what's been seen
#   scripts/knowledge-sweep --dry-run      # build the digest, skip the model
#   scripts/knowledge-sweep --backfill     # work forward through unreviewed history
#   scripts/knowledge-sweep --backfill --until-done   # repeat until history is exhausted
#   scripts/knowledge-sweep --max-sessions=N          # override the per-run session cap

source "$(dirname "$0")/lib/_common.sh"

STATE_DIR="$WORKSPACE_ROOT/.claude/knowledge-sweep"
LEDGER="$STATE_DIR/ledger.json"
STAMP="$STATE_DIR/last-run"
LOCKDIR="$STATE_DIR/sweep.lock.d"
LOG="$STATE_DIR/sweep.log"
PENDING="$STATE_DIR/PENDING"
SOURCES="$STATE_DIR/sources.json"
# Not under .claude/ — Claude Code refuses Write/Edit anywhere beneath a .claude/
# directory, which would give the harvester a checkout it cannot edit.
WORKTREE="${TMPDIR:-/tmp}/cft-knowledge-sweep-wt"
HARVESTER="$WORKSPACE_ROOT/.claude/agents/knowledge-harvester.md"

MIN_INTERVAL_SECONDS=${KNOWLEDGE_SWEEP_INTERVAL:-3600}
QUIESCENT_SECONDS=${KNOWLEDGE_SWEEP_QUIESCENT:-600}
MAX_SESSION_DELTA_BYTES=${KNOWLEDGE_SWEEP_MAX_SESSION_BYTES:-2000000}
MAX_DIGEST_BYTES=${KNOWLEDGE_SWEEP_MAX_DIGEST_BYTES:-400000}
MAX_SESSIONS=${KNOWLEDGE_SWEEP_MAX_SESSIONS:-10}
MODEL=${KNOWLEDGE_SWEEP_MODEL:-sonnet}

# pr — push the author's branch and open/update their PR; branch — commit locally
# and never push.
MODE=${KNOWLEDGE_SWEEP_MODE:-pr}

# The devcontainer is Linux, but the workspace also bootstraps on a macOS host,
# where stat and date take different flags and flock is absent.
if stat -c %s . >/dev/null 2>&1; then
    file_size()  { stat -c %s "$1"; }
    file_mtime() { stat -c %Y "$1"; }
    fmt_epoch()  { date -d "@$1" "+$2"; }
else
    file_size()  { stat -f %z "$1"; }
    file_mtime() { stat -f %m "$1"; }
    fmt_epoch()  { date -r "$1" "+$2"; }
fi

# Every transcript across every source, unordered.
all_transcripts() {
    transcript_dirs | while IFS= read -r d; do
        find "$d" -maxdepth 1 -type f -name '*.jsonl' -print 2>/dev/null
    done
}

# The same, oldest first — without GNU find's -printf.
list_transcripts() {
    all_transcripts \
    | while IFS= read -r f; do printf '%s\t%s\n' "$(file_mtime "$f")" "$f"; done \
    | sort -n | cut -f2-
}

BACKGROUND=0
FORCE=0
DRY_RUN=0
STATUS=0
BACKFILL=0
UNTIL_DONE=0
for arg in "$@"; do
    case "$arg" in
        --background)      BACKGROUND=1 ;;
        --force)           FORCE=1 ;;
        --dry-run)         DRY_RUN=1 ;;
        --status)          STATUS=1 ;;
        --backfill)        BACKFILL=1 ;;
        --until-done)      UNTIL_DONE=1; BACKFILL=1 ;;
        --max-sessions=*)  MAX_SESSIONS="${arg#*=}" ;;
        *)                 die "unknown argument: $arg" ;;
    esac
done

# Backfill is an explicit operator action; the hourly interval doesn't apply.
(( BACKFILL )) && FORCE=1

# The harvester's own claude process inherits this repo's SessionStart hook.
[[ -n "${KNOWLEDGE_SWEEP_CHILD:-}" ]] && exit 0

mkdir -p "$STATE_DIR"
[[ -f "$LEDGER" ]] || printf '{}\n' > "$LEDGER"
[[ -f "$SOURCES" ]] || printf '[]\n' > "$SOURCES"

# Which CLI does the harvesting. Claude Code is the default because the
# harvester is written as one of its agents; a Codex-only engineer needs
# KNOWLEDGE_SWEEP_HARVEST_CMD, which receives the prompt on stdin.
HARVEST_CMD=${KNOWLEDGE_SWEEP_HARVEST_CMD:-}
if [[ -z "$HARVEST_CMD" ]]; then
    if command -v claude >/dev/null; then
        HARVEST_CMD="claude -p --model $MODEL --permission-mode acceptEdits"
        HARVEST_CMD+=" --allowedTools Read Edit Write Grep Glob Bash(./scripts/docs-index)"
    elif command -v codex >/dev/null; then
        # Untested: no Codex install was available to verify the invocation or
        # its sandbox flags. Override with KNOWLEDGE_SWEEP_HARVEST_CMD if wrong.
        HARVEST_CMD="codex exec"
    fi
fi

# Claude Code's layout: a slug of the project path, every non-alphanumeric
# character replaced by a hyphen.
claude_transcript_dir() {
    local slug
    slug=$(printf '%s' "$WORKSPACE_ROOT" | sed 's/[^a-zA-Z0-9]/-/g')
    # Newline-terminated: this is read line-wise, not captured.
    printf '%s/.claude/projects/%s\n' "$HOME" "$slug"
}

# Both clients hand a hook one JSON object on stdin carrying transcript_path.
# Recording its directory means no client's storage layout has to be hardcoded —
# the sweep learns where transcripts live the first time that client's hook runs.
record_source_from_stdin() {
    [[ -t 0 ]] && return 0
    local payload="" path dir tmp
    # bash's own timed read: this runs on the session-start path, so it must
    # never block, and `timeout` is absent on macOS.
    read -r -t 2 -d '' payload 2>/dev/null || true
    [[ -n "$payload" ]] || return 0
    path=$(printf '%s' "$payload" | jq -r '.transcript_path // empty' 2>/dev/null || printf '')
    [[ -n "$path" ]] || return 0
    dir=$(dirname "$path")
    [[ -d "$dir" ]] || return 0
    tmp=$(mktemp)
    if jq --arg d "$dir" '. + [$d] | unique' "$SOURCES" > "$tmp" 2>/dev/null; then
        mv "$tmp" "$SOURCES"
    else
        rm -f "$tmp"
    fi
}

# Every directory worth sweeping: Claude's derived path, plus whatever any
# client's hook has taught us.
transcript_dirs() {
    { claude_transcript_dir; jq -r '.[]' "$SOURCES" 2>/dev/null; } \
    | while IFS= read -r d; do [[ -d "$d" ]] && printf '%s\n' "$d"; done \
    | sort -u
}

# Unreviewed bytes across every transcript, and how many sessions they span.
# A session marked `seeded` was never read, so all of it counts as unreviewed.
progress() {
    all_transcripts \
    | while IFS= read -r path; do
        local name size sid offset
        name=$(basename "$path"); size=$(file_size "$path")
        sid="${name%.jsonl}"
        offset=$(jq -r --arg s "$sid" \
            'if (.[$s].seeded == true) then 0 else (.[$s].offset // 0) end' "$LEDGER")
        printf '%s\n' "$(( size - offset ))"
    done \
    | awk '{ if ($1 > 0) { total += $1; n++ } }
           END { printf "%.1f\t%d\t%d\n", total/1048576, n+0, total+0 }'
}

record_source_from_stdin

if [[ $STATUS -eq 1 ]]; then
    info "knowledge-sweep status"
    if [[ -f "$STAMP" ]]; then
        log "  last run: $(fmt_epoch "$(file_mtime "$STAMP")" '%Y-%m-%d %H:%M:%S')"
    else
        log "  last run: never"
    fi
    log "  sessions in ledger: $(jq 'length' "$LEDGER")"
    log "  never read (seeded): $(jq '[.[] | select(.seeded == true)] | length' "$LEDGER")"
    IFS=$'\t' read -r mb sessions _ < <(progress)
    log "  unreviewed: ${mb} MB across ${sessions} session(s)"
    log "  transcript sources:"
    transcript_dirs | while IFS= read -r d; do log "    $d"; done
    if [[ -s "$PENDING" ]]; then
        log ""
        cat "$PENDING"
    else
        log "  no proposals pending"
    fi
    exit 0
fi

# Re-invokes itself so each batch gets clean state, and so the lock below is
# held per batch rather than for the whole backfill.
if [[ $UNTIL_DONE -eq 1 ]]; then
    for (( batch = 1; batch <= ${KNOWLEDGE_SWEEP_MAX_BATCHES:-200}; batch++ )); do
        IFS=$'\t' read -r mb sessions _ < <(progress)
        before=$(jq '[.[].offset // 0] | add // 0' "$LEDGER")
        info "backfill batch $batch — ${mb} MB unreviewed across ${sessions} session(s)"
        if [[ "$sessions" == "0" ]]; then
            ok "backfill complete"
            exit 0
        fi
        out=$("$0" --backfill --force 2>&1) || true
        printf '%s\n' "$out"
        if grep -q 'nothing new to review' <<<"$out"; then
            ok "backfill complete"
            exit 0
        fi
        # A batch that consumes nothing has failed for a reason retrying won't
        # fix — a DNS outage or an expired credential, not the content. Stop
        # rather than spending the batch budget on the same failure.
        #
        # Measured on total ledger offsets, which only move when work is done.
        # Unreviewed bytes would drift on their own as live sessions append.
        after=$(jq '[.[].offset // 0] | add // 0' "$LEDGER")
        if (( after <= before )); then
            err "batch $batch consumed no transcript — stopping. Nothing was skipped; rerun to resume."
            exit 1
        fi
    done
    warn "batch limit reached — run again to continue"
    exit 0
fi

if [[ $BACKGROUND -eq 1 ]]; then
    nohup "$0" ${FORCE:+--force} >> "$LOG" 2>&1 &
    exit 0
fi

# mkdir is the portable atomic lock; macOS has no flock. A lock whose owning
# process is gone is reclaimed, so a killed run doesn't wedge every later one.
acquire_lock() {
    if mkdir "$LOCKDIR" 2>/dev/null; then
        printf '%s\n' "$$" > "$LOCKDIR/pid"
        return 0
    fi
    local owner
    owner=$(cat "$LOCKDIR/pid" 2>/dev/null || printf '')
    if [[ -z "$owner" ]] || ! kill -0 "$owner" 2>/dev/null; then
        rm -rf "$LOCKDIR"
        mkdir "$LOCKDIR" 2>/dev/null || return 1
        printf '%s\n' "$$" > "$LOCKDIR/pid"
        return 0
    fi
    return 1
}
acquire_lock || exit 0
cleanup() { rm -rf "$LOCKDIR" "${WORK:-}"; }
trap cleanup EXIT

if [[ $FORCE -eq 0 && -f "$STAMP" ]]; then
    age=$(( $(date +%s) - $(file_mtime "$STAMP") ))
    if (( age < MIN_INTERVAL_SECONDS )); then
        exit 0
    fi
fi

[[ -n "$(transcript_dirs)" ]] || { warn "no transcript directory found for this workspace"; exit 0; }

# A first run faces every session ever held here. The digest cap means most of
# that backlog would be recorded as seen without being read, so decline it
# explicitly rather than lying in the ledger.
if [[ "$(jq 'length' "$LEDGER")" == "0" && $BACKFILL -eq 0 ]]; then
    seeded=0
    tmp=$(mktemp)
    cp "$LEDGER" "$tmp"
    while IFS= read -r t; do
        sid=$(basename "$t" .jsonl)
        jq --arg s "$sid" --argjson o "$(file_size "$t")" \
           --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
           '.[$s] = {offset: $o, reviewed_at: $t, seeded: true}' "$tmp" > "$tmp.next"
        mv "$tmp.next" "$tmp"
        seeded=$(( seeded + 1 ))
    done < <(all_transcripts)
    mv "$tmp" "$LEDGER"
    touch "$STAMP"
    ok "first run: marked $seeded existing session(s) as seen — sweeping new activity from now on"
    log "to review the backlog instead: scripts/knowledge-sweep --backfill --force"
    exit 0
fi

# Seeding recorded each session's full size without reading it. A backfill has to
# undo that once, so the walk below starts from the beginning of each session.
if (( BACKFILL )) && [[ "$(jq '[.[] | select(.seeded == true)] | length' "$LEDGER")" != "0" ]]; then
    tmp=$(mktemp)
    jq 'with_entries(if .value.seeded == true
                     then .value = {offset: 0, backfill: true}
                     else . end)' "$LEDGER" > "$tmp"
    mv "$tmp" "$LEDGER"
    ok "backfill: reset $(jq '[.[] | select(.backfill == true)] | length' "$LEDGER") seeded session(s) to be read from the start"
fi

command -v claude >/dev/null || die "claude CLI not on PATH"
command -v jq >/dev/null || die "jq not on PATH"

WORK=$(mktemp -d)

DIGEST="$WORK/digest.md"
: > "$DIGEST"

# The readable spine of a transcript slice: what was asked, what was answered,
# which commands ran. Bulk tool output is clipped.
digest_slice() {
    jq -R 'fromjson? // empty' \
    | jq -r '
        def clip($n):
          (. // "") | tostring
          | if (length > $n) then (.[0:$n] + " …[clipped]") else . end;
        def blocks:
          if (.message.content | type) == "array" then .message.content
          elif (.message.content | type) == "string" then [{type: "text", text: .message.content}]
          else [] end;
        select(.type == "user" or .type == "assistant")
        | (if .type == "user" then "USER" else "CLAUDE" end) as $role
        | blocks[]
        | if .type == "text" then
            (if ((.text // "") | length) > 0 then "\($role): \(.text | clip(2000))" else empty end)
          elif .type == "tool_use" then
            "  TOOL \(.name // "?"): \((.input.command // .input.file_path // .input.pattern // .input.description // "") | clip(300))"
          elif .type == "tool_result" then
            "  RESULT: \((if (.content | type) == "array" then ([.content[]? | .text? // ""] | join(" ")) else .content end) | clip(400))"
          else empty end
      ' 2>/dev/null || true
}

sessions_reviewed=0
declare -A new_offsets=()

while IFS= read -r transcript; do
    (( sessions_reviewed >= MAX_SESSIONS )) && break

    sid=$(basename "$transcript" .jsonl)
    size=$(file_size "$transcript")
    mtime=$(file_mtime "$transcript")

    # A transcript touched moments ago belongs to a session still in progress.
    if (( $(date +%s) - mtime < QUIESCENT_SECONDS )); then
        continue
    fi

    offset=$(jq -r --arg s "$sid" '.[$s].offset // 0' "$LEDGER")
    (( size <= offset )) && continue

    delta=$(( size - offset ))
    slice="$WORK/$sid.txt"
    truncated=""

    if (( delta <= MAX_SESSION_DELTA_BYTES )); then
        next_offset=$size
        tail -c "+$(( offset + 1 ))" "$transcript" | digest_slice > "$slice"
    elif (( BACKFILL )); then
        # Walk forward from the offset, taking whole lines up to the cap, and
        # advance only by what was consumed. Successive runs cover the session
        # instead of skipping to its tail.
        #
        # BSD dd has no skip_bytes/count_bytes, so read the window with
        # tail | head. head closing the pipe SIGPIPEs tail, which pipefail
        # would make fatal — hence the guard. The window size is checked below,
        # so a genuinely failed read still can't pass silently.
        raw="$WORK/$sid.raw"
        { tail -c "+$(( offset + 1 ))" "$transcript" \
            | head -c "$MAX_SESSION_DELTA_BYTES"; } > "$raw" 2>/dev/null || true

        window=$(file_size "$raw")
        if (( window <= 0 )); then
            warn "$sid: read nothing at offset $offset — skipping session"
            continue
        fi
        if [[ -z "$(tail -c 1 "$raw")" ]]; then
            # Window happens to end on a newline, so every line in it is whole.
            consumed=$window
        else
            consumed=$(LC_ALL=C awk '{ p = n; n += length($0) + 1 } END { print p + 0 }' "$raw")
        fi
        if (( consumed <= 0 )); then
            # A single line longer than the cap. Take the window as-is and move
            # on; digest_slice drops the unparseable fragment.
            warn "$sid: no line boundary within ${MAX_SESSION_DELTA_BYTES}B of offset $offset"
            consumed=$window
        fi

        next_offset=$(( offset + consumed ))
        head -c "$consumed" "$raw" | digest_slice > "$slice"
        truncated=" (backfill: bytes $offset–$next_offset of $size)"
    else
        # Forward sweeping favours recent activity; a session that grew faster
        # than the cap loses its middle, so say so rather than failing quietly.
        start=$(( size - MAX_SESSION_DELTA_BYTES + 1 ))
        next_offset=$size
        # Drop the partial first line left by starting mid-file.
        tail -c "+$start" "$transcript" | tail -n +2 | digest_slice > "$slice"
        truncated=" (skipped $(( delta - MAX_SESSION_DELTA_BYTES )) earlier bytes)"
        warn "$sid: delta ${delta}B exceeds the per-session cap — reviewed the most recent ${MAX_SESSION_DELTA_BYTES}B only"
    fi

    if [[ ! -s "$slice" ]]; then
        # A window with bytes in it that yields no readable turns means the
        # extraction doesn't understand this client's transcript format. Say so
        # — otherwise the offset advances and the history is silently consumed.
        warn "$sid: $(( next_offset - offset ))B of new transcript produced no readable turns"
        new_offsets[$sid]=$next_offset
        continue
    fi

    {
        printf '\n## Session %s\n' "$sid"
        printf 'Last active: %s%s\n\n' "$(fmt_epoch "$mtime" '%Y-%m-%d %H:%M')" "$truncated"
        cat "$slice"
    } >> "$DIGEST"

    new_offsets[$sid]=$next_offset
    sessions_reviewed=$(( sessions_reviewed + 1 ))

    if (( $(file_size "$DIGEST") > MAX_DIGEST_BYTES )); then
        printf '\n[digest truncated — remaining sessions deferred to the next sweep]\n' >> "$DIGEST"
        break
    fi
done < <(list_transcripts)

[[ $DRY_RUN -eq 0 ]] && touch "$STAMP"

commit_ledger() {
    local tmp="$WORK/ledger.json"
    cp "$LEDGER" "$tmp"
    for sid in "${!new_offsets[@]}"; do
        jq --arg s "$sid" --argjson o "${new_offsets[$sid]}" \
           --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
           '.[$s] = {offset: $o, reviewed_at: $t}' "$tmp" > "$tmp.next"
        mv "$tmp.next" "$tmp"
    done
    mv "$tmp" "$LEDGER"
}

if [[ ! -s "$DIGEST" ]]; then
    commit_ledger
    log "$(date '+%F %T') nothing new to review"
    exit 0
fi

if [[ $DRY_RUN -eq 1 ]]; then
    ok "digest built: $(file_size "$DIGEST") bytes from $sessions_reviewed session(s)"
    cp "$DIGEST" "$STATE_DIR/last-digest.md"
    log "written to $STATE_DIR/last-digest.md (ledger not advanced)"
    exit 0
fi

# One long-lived branch per author, so repeated sweeps accumulate onto a single
# open PR.
GH_LOGIN=$(gh api user --jq .login 2>/dev/null || printf '')
if [[ -z "$GH_LOGIN" ]]; then
    # Defer rather than downgrade: a batch committed to knowledge/local is
    # thrown away, and the outage is usually transient (DNS, expired token).
    # Exiting before the model runs costs nothing and leaves the ledger intact.
    [[ "$MODE" == "pr" ]] && die "gh unavailable — deferring this batch, nothing consumed"
    GH_LOGIN=local
fi
BRANCH="knowledge/$GH_LOGIN"

git -C "$WORKSPACE_ROOT" fetch --quiet origin master 2>/dev/null || true
git -C "$WORKSPACE_ROOT" fetch --quiet origin "$BRANCH" 2>/dev/null || true

EXISTING_PR=""
if [[ "$MODE" == "pr" ]]; then
    EXISTING_PR=$(gh pr list --head "$BRANCH" --state open --json number --jq '.[0].number // ""' 2>/dev/null || printf '')
fi

REBASED=0
if [[ -n "$EXISTING_PR" ]] && git -C "$WORKSPACE_ROOT" rev-parse --verify --quiet "origin/$BRANCH" >/dev/null; then
    BASE="origin/$BRANCH"
    REBASED=1
else
    BASE=$(git -C "$WORKSPACE_ROOT" rev-parse --verify --quiet origin/master \
        || git -C "$WORKSPACE_ROOT" rev-parse master)
fi

rm -rf "$WORKTREE"
git -C "$WORKSPACE_ROOT" worktree prune
git -C "$WORKSPACE_ROOT" worktree add --quiet --force -B "$BRANCH" "$WORKTREE" "$BASE"

if (( REBASED )); then
    if ! git -C "$WORKTREE" rebase --quiet origin/master 2>/dev/null; then
        git -C "$WORKTREE" rebase --abort 2>/dev/null || true
        warn "could not rebase $BRANCH onto origin/master — proposing against its existing base"
    fi
fi

cleanup_worktree() {
    git -C "$WORKSPACE_ROOT" worktree remove --force "$WORKTREE" 2>/dev/null || true
    git -C "$WORKSPACE_ROOT" worktree prune
}

SUMMARY="$WORKTREE/sweep-summary.local.md"
cp "$DIGEST" "$WORKTREE/sweep-digest.local.md"

# The instructions live in the agent definition so they can also be run
# interactively; the body doubles as the headless prompt.
PROMPT_BODY=$(awk '/^---[[:space:]]*$/{c++; next} c>=2{print}' "$HARVESTER")
[[ -n "$PROMPT_BODY" ]] || { cleanup_worktree; die "could not read harvester prompt from $HARVESTER"; }

[[ -n "$HARVEST_CMD" ]] || { cleanup_worktree; die "no harvester CLI — install claude, or set KNOWLEDGE_SWEEP_HARVEST_CMD"; }

set +e
(
    cd "$WORKTREE" || exit 1
    export KNOWLEDGE_SWEEP_CHILD=1
    printf '%s\n\nThe digest is at `sweep-digest.local.md`. Write your summary to `sweep-summary.local.md`.\n' "$PROMPT_BODY" \
    | $HARVEST_CMD > "$WORK/model.log" 2>&1
)
model_status=$?
set -e

cat "$WORK/model.log" >> "$LOG"

rm -f "$WORKTREE/sweep-digest.local.md"

if (( model_status != 0 )); then
    warn "harvester exited $model_status — see $LOG"
    cleanup_worktree
    git -C "$WORKSPACE_ROOT" branch -D "$BRANCH" 2>/dev/null || true
    exit 1
fi

# This repo is public, so a pasted command line carrying a live token must not
# reach a branch even though the harvester is told never to quote a transcript.
if git -C "$WORKTREE" diff --unified=0 | rg -q \
    -e 'eyJ[A-Za-z0-9_-]{20,}\.' \
    -e 'gh[pousr]_[A-Za-z0-9]{20,}' \
    -e 'AccountKey=' \
    -e 'BEGIN (RSA|EC|OPENSSH|PRIVATE) ' \
    -e '(client_secret|api[_-]?key|password)["'\'':= ]+[A-Za-z0-9/+_-]{16,}'; then
    err "secret-shaped string in proposed diff — discarding branch $BRANCH"
    cleanup_worktree
    git -C "$WORKSPACE_ROOT" branch -D "$BRANCH" 2>/dev/null || true
    # Deliberately no commit_ledger: advancing here would mark the window
    # reviewed while throwing its content away, so it could never be revisited.
    # A backfill will stop on the no-progress guard if the block persists, which
    # is the right outcome — it needs a human, not a silent skip.
    exit 1
fi

if [[ -z "$(git -C "$WORKTREE" status --porcelain)" ]]; then
    log "$(date '+%F %T') reviewed $sessions_reviewed session(s), no documentation changes proposed"
    cleanup_worktree
    git -C "$WORKSPACE_ROOT" branch -D "$BRANCH" 2>/dev/null || true
    commit_ledger
    exit 0
fi

summary_text="(no summary written)"
[[ -s "$SUMMARY" ]] && summary_text=$(cat "$SUMMARY")
rm -f "$SUMMARY"

git -C "$WORKTREE" add -A
git -C "$WORKTREE" commit --quiet -m "docs: knowledge sweep $(date +%F)" \
    -m "Proposed from $sessions_reviewed reviewed session(s) by scripts/knowledge-sweep. Unreviewed — verify before merging." \
    -m "$summary_text"

if [[ "$MODE" != "pr" ]]; then
    cleanup_worktree
    commit_ledger
    {
        printf 'knowledge-sweep: %s proposes documentation changes (local only)\n' "$BRANCH"
        printf '  review:  git diff master..%s\n' "$BRANCH"
        printf '  discard: git branch -D %s\n\n' "$BRANCH"
        printf '%s\n' "$summary_text"
    } > "$PENDING"
    ok "proposed changes on $BRANCH"
    exit 0
fi

if ! git -C "$WORKTREE" push --quiet --force-with-lease -u origin "$BRANCH" 2>>"$LOG"; then
    warn "push of $BRANCH failed — commit kept locally, see $LOG"
    cleanup_worktree
    commit_ledger
    exit 1
fi

PR_BODY="$WORK/pr-body.md"
{
    printf 'Documentation updates proposed by `scripts/knowledge-sweep` from this author'\''s recent workspace sessions.\n\n'
    printf '**Unreviewed machine output.** Every claim needs checking against the source repos before merge.\n\n'
    printf '## Proposed in the latest sweep\n\n%s\n\n' "$summary_text"
    printf -- '---\n\nThis branch accumulates: later sweeps add commits here rather than opening another PR.\n'
    printf 'The daily consolidation workflow folds open sweep PRs together — see `.github/workflows/knowledge-consolidate.yml`.\n'
} > "$PR_BODY"

if [[ -n "$EXISTING_PR" ]]; then
    gh pr edit "$EXISTING_PR" --body-file "$PR_BODY" >/dev/null 2>>"$LOG" || true
    # A backfill runs dozens of batches; the commit log carries their history
    # without a comment per batch.
    if (( ! BACKFILL )); then
        gh pr comment "$EXISTING_PR" --body "New sweep added $(date -u +%Y-%m-%dT%H:%MZ):

$summary_text" >/dev/null 2>>"$LOG" || true
    fi
    PR_URL=$(gh pr view "$EXISTING_PR" --json url --jq .url 2>/dev/null || printf '')
    ok "updated PR #$EXISTING_PR"
else
    gh label create knowledge-sweep --color BFD4F2 \
        --description "Documentation proposed by scripts/knowledge-sweep" >/dev/null 2>&1 || true
    PR_URL=$(gh pr create \
        --base master \
        --head "$BRANCH" \
        --title "docs: knowledge sweep — $GH_LOGIN" \
        --body-file "$PR_BODY" \
        --label knowledge-sweep 2>>"$LOG" || printf '')
    [[ -n "$PR_URL" ]] && ok "opened $PR_URL" || warn "pushed $BRANCH but PR creation failed — see $LOG"
fi

cleanup_worktree
commit_ledger

{
    printf 'knowledge-sweep proposed documentation changes\n'
    printf '  %s\n\n' "${PR_URL:-$BRANCH}"
    printf '%s\n' "$summary_text"
} > "$PENDING"

log "$summary_text"
