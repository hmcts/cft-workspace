JENKINS_URL=https://build.hmcts.net/
# Jenkins uses the azure-ad realm, which keys users on Entra Object ID (a GUID),
# not your UPN. Find yours with: az ad signed-in-user show --query id -o tsv
JENKINS_USERNAME=[your entra object id]
# An API token from https://build.hmcts.net/me/configure — an Entra password
# will NOT work against the API (401), auth is delegated to Entra SSO.
JENKINS_PASSWORD=[your jenkins api token]
JENKINS_TIMEOUT=30
JENKINS_VERIFY_SSL=true
